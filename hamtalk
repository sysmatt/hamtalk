#!/usr/bin/env python3
"""
hamtalk — ham radio CQ exchange listener.
Captures microphone audio in chunks and transcribes with faster-whisper.
"""

import argparse
import datetime
import os
import re
import sys
import wave
import numpy as np
import sounddevice as sd
from faster_whisper import WhisperModel

SAMPLE_RATE = 16000  # Whisper expects 16 kHz
CHANNELS = 1
VAD_FRAME_MS = 30
VAD_FRAME_SAMPLES = SAMPLE_RATE * VAD_FRAME_MS // 1000  # 480 samples per frame

BOLD_GREEN = "\033[1;92m"
RESET = "\033[0m"

NATO = {
    # Standard NATO phonetic alphabet
    "alpha": "A", "bravo": "B", "charlie": "C", "delta": "D",
    "echo": "E", "foxtrot": "F", "golf": "G", "hotel": "H",
    "india": "I", "juliet": "J", "kilo": "K", "lima": "L",
    "mike": "M", "november": "N", "oscar": "O", "papa": "P",
    "quebec": "Q", "romeo": "R", "sierra": "S", "tango": "T",
    "uniform": "U", "victor": "V", "whiskey": "W", "x-ray": "X",
    "yankee": "Y", "zulu": "Z",
    # Old ICAO "Able Baker" alphabet (pre-1956, still common on air)
    "able": "A", "baker": "B", "dog": "D", "easy": "E",
    "fox": "F", "george": "G", "how": "H", "item": "I",
    "jig": "J", "king": "K", "love": "L", "nan": "N",
    "oboe": "O", "peter": "P", "queen": "Q", "roger": "R",
    "sugar": "S", "tare": "T", "uncle": "U", "william": "W",
    "yoke": "Y", "zebra": "Z",
    # Common ham radio informal/regional alternatives
    "adam": "A", "america": "A", "apple": "A",
    "boy": "B", "boston": "B",
    "canada": "C",
    "david": "D", "denver": "D",
    "edward": "E", "england": "E",
    "frank": "F", "frederick": "F", "florida": "F",
    "germany": "G", "gold": "G",
    "henry": "H", "harry": "H",
    "ida": "I", "italy": "I",
    "john": "J", "japan": "J",
    "kentucky": "K",
    "london": "L", "lincoln": "L",
    "mary": "M", "mexico": "M", "mother": "M",
    "nancy": "N", "norway": "N",
    "ocean": "O", "ontario": "O", "ohio": "O",
    "paul": "P", "paris": "P",
    "radio": "R", "robert": "R",
    "sam": "S", "santiago": "S",
    "texas": "T", "tom": "T", "tommy": "T",
    "union": "U",
    "victoria": "V", "virginia": "V",
    "washington": "W", "willie": "W",
    "yellow": "Y",
}

CALLSIGN_RE = re.compile(r'\b[AKNW][A-Z]{0,2}\d[A-Z]{1,4}\b')

NUMBER_WORDS = {
    "zero": "0", "oh": "0",
    "one": "1", "won": "1",
    "two": "2", "to": "2", "too": "2",
    "three": "3", "tree": "3",
    "four": "4", "for": "4", "fore": "4",
    "five": "5", "fife": "5",
    "six": "6",
    "seven": "7",
    "eight": "8", "ate": "8",
    "nine": "9", "niner": "9",
}


def annotate_callsigns(text: str) -> str:
    # Pre-expand dashes/dots between alphanumeric chars across the whole text
    # so Whisper's "CQ-CQ-K2-TTA" becomes "CQ CQ K2 TTA" before we split
    text = re.sub(r'(?<=[A-Za-z0-9])[-.](?=[A-Za-z0-9])', ' ', text)
    words = text.split()
    if not words:
        return text

    def decode_word(w):
        expanded = re.sub(r'(?<=[A-Z0-9])[-.](?=[A-Z0-9])', ' ', w.upper())
        result = []
        for p in expanded.split():
            stripped = p.strip(".,!?").lower()
            result.append(NATO.get(stripped) or NUMBER_WORDS.get(stripped) or p.strip(".,!?"))
        return result

    decoded = [decode_word(w) for w in words]
    output = []
    i = 0

    while i < len(words):
        best_cs = None
        best_j = i + 1

        for j in range(min(i + 6, len(words)), i, -1):
            flat = [tok for k in range(i, j) for tok in decoded[k]]

            rejoined = " ".join(flat)
            collapsed = re.sub(
                r'\b[A-Z0-9](?: [A-Z0-9])+\b',
                lambda m: m.group().replace(' ', ''),
                rejoined,
            ).strip()

            for candidate in (collapsed, "".join(flat)):
                if CALLSIGN_RE.fullmatch(candidate):
                    best_cs, best_j = candidate, j
                    break
            if best_cs:
                break

        if best_cs:
            output.append(f"{' '.join(words[i:best_j])} {BOLD_GREEN}[{best_cs}]{RESET}")
            i = best_j
        else:
            output.append(words[i])
            i += 1

    return " ".join(output)


def save_wav(audio: np.ndarray, save_dir: str, timestamp: datetime.datetime):
    us = f"{timestamp.microsecond:06d}"
    filename = timestamp.strftime("hamtalk-%Y%m%d-%H%M%S.") + us + ".wav"
    path = os.path.join(save_dir, filename)
    audio_int16 = (np.clip(audio, -1.0, 1.0) * 32767).astype(np.int16)
    with wave.open(path, 'wb') as wf:
        wf.setnchannels(CHANNELS)
        wf.setsampwidth(2)
        wf.setframerate(SAMPLE_RATE)
        wf.writeframes(audio_int16.tobytes())


def list_devices():
    devices = sd.query_devices()
    print("Available audio input devices:")
    for i, dev in enumerate(devices):
        if dev["max_input_channels"] > 0:
            marker = " (default)" if i == sd.default.device[0] else ""
            print(f"  [{i}] {dev['name']}{marker}")


def select_device(device_index: int | None) -> int:
    if device_index is not None:
        info = sd.query_devices(device_index)
        if info["max_input_channels"] < 1:
            print(f"Error: device {device_index} has no input channels.", file=sys.stderr)
            sys.exit(1)
        return device_index

    default = sd.default.device[0]
    if default is None or default < 0:
        print("Error: no default input device found. Use --device to specify one.", file=sys.stderr)
        sys.exit(1)
    return default


def transcribe_loop(device: int, model: WhisperModel, args):
    dev_name = sd.query_devices(device)["name"]
    print(f"Listening on: [{device}] {dev_name}  (Ctrl+C to stop)\n", flush=True)

    if args.save:
        os.makedirs(args.save, exist_ok=True)

    speech_frames = []
    silent_count = 0
    in_speech = False

    try:
        with sd.InputStream(device=device, channels=CHANNELS, samplerate=SAMPLE_RATE,
                            dtype="float32") as stream:
            while True:
                frame, _ = stream.read(VAD_FRAME_SAMPLES)
                frame_mono = frame[:, 0]

                is_speech = float(np.sqrt(np.mean(frame_mono ** 2))) > args.energy_threshold

                if is_speech:
                    in_speech = True
                    silent_count = 0
                    speech_frames.append(frame_mono)
                elif in_speech:
                    silent_count += 1
                    speech_frames.append(frame_mono)
                    if silent_count >= args.silence_frames:
                        try:
                            if len(speech_frames) >= args.min_speech_frames:
                                now = datetime.datetime.now(datetime.timezone.utc)
                                ts = now.strftime("%H:%M:%S")
                                audio = np.concatenate(speech_frames)

                                if args.save:
                                    save_wav(audio, args.save, now)

                                segments, _ = model.transcribe(
                                    audio,
                                    language="en",
                                    beam_size=5,
                                    condition_on_previous_text=False,
                                )
                                parts = [
                                    seg.text.strip()
                                    for seg in segments
                                    if seg.no_speech_prob < 0.6
                                ]
                                text = " ".join(parts).strip()
                                if text:
                                    print(f"[{ts}] {annotate_callsigns(text)}", flush=True)
                        except Exception as e:
                            print(f"[error: {e}]", file=sys.stderr, flush=True)
                        finally:
                            speech_frames = []
                            silent_count = 0
                            in_speech = False

    except KeyboardInterrupt:
        print("\nStopped.", flush=True)


def main():
    parser = argparse.ArgumentParser(
        prog="hamtalk",
        description="hamtalk — ham radio CQ exchange listener"
    )
    parser.add_argument(
        "--list-devices", action="store_true",
        help="List available audio input devices and exit"
    )
    parser.add_argument(
        "--device", "-d", type=int, default=None, metavar="INDEX",
        help="Audio input device index (default: system default)"
    )
    parser.add_argument(
        "--model", "-m", default="base",
        choices=["tiny", "base", "small", "medium", "large-v2", "large-v3"],
        help="Whisper model size (default: base)"
    )
    parser.add_argument(
        "--compute-type", default="int8",
        choices=["int8", "float16", "float32"],
        help="Model compute type — int8 is fastest on CPU (default: int8)"
    )
    parser.add_argument(
        "--energy-threshold", type=float, default=0.01, metavar="LEVEL",
        help="RMS energy threshold for VAD speech detection (default: 0.01)"
    )
    parser.add_argument(
        "--silence-frames", type=int, default=15, metavar="N",
        help="Silent 30ms frames before utterance flushes (default: 15 ≈ 450ms)"
    )
    parser.add_argument(
        "--min-speech-frames", type=int, default=5, metavar="N",
        help="Minimum speech frames required to transcribe (default: 5 ≈ 150ms)"
    )
    parser.add_argument(
        "--save", metavar="DIRECTORY",
        help="Save each utterance as a WAV file in this directory"
    )
    args = parser.parse_args()

    if args.list_devices:
        list_devices()
        return

    device = select_device(args.device)

    print(f"Loading Whisper model '{args.model}' ({args.compute_type})...", flush=True)
    model = WhisperModel(args.model, device="cpu", compute_type=args.compute_type)
    print("Model ready.", flush=True)

    transcribe_loop(device, model, args)


if __name__ == "__main__":
    main()
